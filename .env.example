# Copy to .env and fill in real values. python-decouple reads this file.
# Every variable here has a working development default — a fresh clone runs
# with no .env at all. These matter only when the app is served to anyone else.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to POST once behind a domain over HTTPS,
# e.g. https://aqua.example.com. Leave blank for local/IP-only.
CSRF_TRUSTED_ORIGINS=

# Set True ONLY when TLS terminates in front of the app (nginx + certbot, or a
# Cloudflare tunnel): enables the HTTPS redirect, HSTS and secure cookies.
# True without HTTPS locks you out via a redirect loop.
SECURE_SSL=False

# Display timezone (any IANA name, e.g. UTC, Asia/Kolkata).
# Storage stays UTC regardless (USE_TZ=True).
TIME_ZONE=Asia/Kolkata

# Verbosity of the app's own loggers (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
